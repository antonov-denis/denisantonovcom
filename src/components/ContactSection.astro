---
import { site } from '../data/site';
---

<section class="section contact-section" id="contact" aria-labelledby="contact-title">
  <div class="contact-copy reveal">
    <p class="eyebrow">Contact</p>
    <h2 id="contact-title">Send the problem, not a perfect brief.</h2>
    <p>
      A role, a product idea, a system that needs untangling, or a team looking for another
      engineer. A few honest sentences are enough to start.
    </p>
  </div>

  <div class="contact-board reveal">
    <a class="contact-primary" href={`mailto:${site.email}?subject=Hello%20Denis`}>
      <span>Email me</span>
      <strong>{site.email}</strong>
    </a>
    <div class="contact-secondary" aria-label="Additional links">
      <a href={site.linkedin} target="_blank" rel="noreferrer">
        <span>LinkedIn</span>
        <strong>Profile</strong>
      </a>
      <a href="/resume.pdf" target="_blank">
        <span>Resume</span>
        <strong>PDF</strong>
      </a>
    </div>
  </div>
</section>
