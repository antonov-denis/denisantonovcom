---
import { skills } from '../data/site';
---

<section class="section" aria-labelledby="skills-title">
  <div class="section-head reveal">
    <div>
      <p class="eyebrow">Stack behind the story</p>
      <h2 id="skills-title">Tools grouped by the work they support.</h2>
    </div>
    <p>The stack reads as capability rather than a keyword cloud, which makes it easier to scan on small screens.</p>
  </div>
  <div class="skills-grid">
    {
      skills.map((group) => (
        <article class="skill-group reveal">
          <h3>{group.group}</h3>
          <ul>
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))
    }
  </div>
</section>
