---
import { aboutCards } from '../data/site';
---

<section class="section" id="about" aria-labelledby="about-title">
  <div class="section-head about-head reveal">
    <div>
      <p class="eyebrow">About</p>
      <h2 id="about-title">From unclear brief to maintainable system.</h2>
    </div>
    <p>
      I usually do my best work when the problem needs a bit of untangling first: what the workflow
      is, where the state lives, and what future changes should not have to rediscover.
    </p>
  </div>

  <div class="work-map reveal">
    <div class="work-map-spine" aria-hidden="true"></div>
    <div class="work-map-center">
      <span>Workflow</span>
      <strong>Code</strong>
      <span>Handover</span>
    </div>
    <div class="about-lanes">
      {
        aboutCards.map((card, index) => (
          <article class="card reveal">
            <span class="card-index">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </div>
            <p class="proof">{card.proof}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
