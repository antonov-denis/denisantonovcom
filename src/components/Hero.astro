---
import { site } from '../data/site';
---

<section class="section hero" id="top" aria-labelledby="hero-title">
  <figure class="hero-portrait reveal">
    <img src="/profile.jpg" alt="Portrait of Denis Antonov" width="640" height="800" loading="eager" />
  </figure>

  <h1 id="hero-title" class="reveal">{site.name}</h1>
  <p class="hero-role reveal">{site.role}</p>
  <div class="hero-actions reveal" aria-label="Primary actions">
    <a class="icon-link primary" href={`mailto:${site.email}`} aria-label="Email Denis">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3.5" y="5.5" width="17" height="13" rx="2.25"></rect>
        <path d="m5 7 7 5.25L19 7"></path>
      </svg>
    </a>
    <a class="icon-link" href={site.linkedin} target="_blank" rel="noreferrer" aria-label="Open LinkedIn profile">
      <svg viewBox="0 0 24 24" aria-hidden="true" class="brand-icon">
        <path d="M6.94 8.94H3.75v10.31h3.19V8.94Z"></path>
        <path d="M5.35 4.75a1.85 1.85 0 1 0 0 3.7 1.85 1.85 0 0 0 0-3.7Z"></path>
        <path d="M10.05 19.25h3.18v-5.6c0-1.48.68-2.34 1.88-2.34 1.1 0 1.63.78 1.63 2.34v5.6h3.19v-6.35c0-3.02-1.62-4.42-3.78-4.42-1.74 0-2.52.95-2.95 1.62h.03V8.94h-3.18c.04.96 0 10.31 0 10.31Z"></path>
      </svg>
    </a>
    <a class="icon-link" href="/Denis_Antonov_Resume.pdf" target="_blank" aria-label="Open resume">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7 3.75h7.2L18.5 8v12.25H7V3.75Z"></path>
        <path d="M14 4v4.25h4.25"></path>
        <path d="M9.75 12.25h5.5M9.75 15.25h5.5M9.75 18.25h3.25"></path>
      </svg>
    </a>
  </div>
</section>
