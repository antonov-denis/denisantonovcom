---
import { navItems, site } from "../data/site";
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <nav class="nav" aria-label="Primary navigation">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <span>{site.name}</span>
    </a>
    <div class="nav-links">
      {
        navItems.map((item) => (
          <a class="nav-link" href={item.href}>
            {item.label}
          </a>
        ))
      }
    </div>
    <div class="nav-actions">
      <button
        class="theme-toggle"
        type="button"
        aria-label="Toggle color theme"
        data-theme-toggle
      >
        <span class="theme-icons" aria-hidden="true">
          <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2.5M12 19.5V22M4.93 4.93 6.7 6.7M17.3 17.3l1.77 1.77M2 12h2.5M19.5 12H22M4.93 19.07 6.7 17.3M17.3 6.7l1.77-1.77"
            ></path>
          </svg>
          <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24">
            <path d="M20.2 14.8A8.2 8.2 0 0 1 9.2 3.8 8.7 8.7 0 1 0 20.2 14.8Z"
            ></path>
          </svg>
        </span>
      </button>
      <button
        class="menu-button"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle></button>
    </div>
  </nav>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu>
  {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
</div>

<script>
  // Event delegation at module scope: this runs once and keeps working across
  // View Transition navigations, where the header DOM is swapped for a fresh
  // copy (so per-element listeners would go stale).
  const closeDrawer = () => {
    document
      .querySelector("[data-menu-toggle]")
      ?.setAttribute("aria-expanded", "false");
    document.querySelector("[data-mobile-menu]")?.classList.remove("is-open");
    document.body.classList.remove("drawer-open");
  };

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    if (target.closest("[data-theme-toggle]")) {
      const root = document.documentElement;
      const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";
      root.dataset.theme = nextTheme;
      try {
        localStorage.setItem("denis-theme", nextTheme);
      } catch {}
      return;
    }

    const menuButton = target.closest("[data-menu-toggle]");
    if (menuButton) {
      const isOpen = menuButton.getAttribute("aria-expanded") === "true";
      menuButton.setAttribute("aria-expanded", String(!isOpen));
      document
        .querySelector("[data-mobile-menu]")
        ?.classList.toggle("is-open", !isOpen);
      document.body.classList.toggle("drawer-open", !isOpen);
      return;
    }

    // Close the drawer once a navigation link inside it is chosen.
    if (target.closest("[data-mobile-menu] a")) {
      closeDrawer();
    }
  });

  window.addEventListener("keydown", (event) => {
    if (
      event.key === "Escape" &&
      document.querySelector("[data-mobile-menu]")?.classList.contains("is-open")
    ) {
      closeDrawer();
    }
  });
</script>
