---
import { principles } from '../data/site';
---

<section class="section" id="principles" aria-labelledby="principles-title">
  <div class="section-head reveal">
    <div>
      <p class="eyebrow">How I think</p>
      <h2 id="principles-title">My engineering bias: make the next change easier.</h2>
    </div>
    <p>The systems I enjoy working on usually work, but slowly, inconsistently, or with too much hidden cost.</p>
  </div>
  <div class="principles-grid">
    {
      principles.map((principle) => (
        <article class="principle reveal">
          <h3>{principle.title}</h3>
          <p>{principle.body}</p>
          <details>
            <summary>In practice</summary>
            <p>{principle.practice}</p>
          </details>
        </article>
      ))
    }
  </div>
</section>
