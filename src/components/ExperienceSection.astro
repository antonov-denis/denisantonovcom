---
import { experience } from '../data/site';
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="section-head reveal">
    <div>
      <p class="eyebrow">Experience</p>
      <h2 id="experience-title">A career built around ownership, systems, and communication.</h2>
    </div>
    <p>The path is presented as the route into product-aware platform engineering, not only a list of roles.</p>
  </div>
  <div class="experience-list">
    {
      experience.map((item) => (
        <article class="experience-item reveal">
          <div class="experience-meta">{item.meta}</div>
          <div>
            <h3>{item.role}</h3>
            <p>{item.body}</p>
            <div class="chips">
              {item.tags.map((tag) => <span class="chip">{tag}</span>)}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
