---
import { experience } from "../data/site";
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="section-head reveal">
    <div>
      <p class="eyebrow">Experience</p>
      <h2 id="experience-title">Where I've worked.</h2>
    </div>
  </div>
  <div class="experience-list">
    {
      experience.map((item) => (
        <article class="experience-item reveal">
          <div class="experience-meta">
            <span class="experience-company">{item.meta}</span>
            <div class="experience-period" aria-label={`Period: ${item.range}`}>
              <strong>{item.range}</strong>
              <em>{item.duration}</em>
            </div>
          </div>
          <div>
            <h3>{item.role}</h3>
          </div>
        </article>
      ))
    }
  </div>

  <div class="section-foot reveal">
    <p>Full detail in the <a class="inline-link" href="/resume.pdf" target="_blank">resume</a>.</p>
  </div>
</section>
