---
import { getPosts, typeLabels, formatDate } from "../lib/blog";

const posts = (await getPosts()).slice(0, 2);
---

<section class="section" id="writing" aria-labelledby="writing-title">
  <div class="section-head reveal">
    <div>
      <p class="eyebrow">Writing</p>
      <h2 id="writing-title">Notes on systems I've built.</h2>
    </div>
    <p>The decisions, and what I'd do differently.</p>
  </div>

  <div class="post-list">
    {
      posts.map((post) => (
        <a class="post-card reveal" href={`/blog/${post.id}`}>
          <span class="type-tag">{typeLabels[post.data.type]}</span>
          <span class="post-card-title">{post.data.title}</span>
          <span class="post-card-desc">{post.data.description}</span>
          <span class="post-card-date">{formatDate(post.data.pubDate)}</span>
        </a>
      ))
    }
  </div>

  <div class="section-foot reveal">
    <a class="text-link" href="/blog">All posts →</a>
  </div>
</section>
