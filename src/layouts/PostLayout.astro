---
import SiteHeader from "../components/SiteHeader.astro";
import { site } from "../data/site";
import { typeLabels, formatDate, type Post } from "../lib/blog";
import Layout from "./Layout.astro";

type Props = { post: Post };

const { post } = Astro.props;
const { title, description, type, pubDate } = post.data;
---

<Layout title={`${title} — ${site.name}`} description={description}>
  <SiteHeader />
  <main id="main">
    <article class="post">
      <div class="post-back">
        <a class="text-link" href="/blog">← All posts</a>
      </div>

      <header class="post-header">
        <div class="post-meta">
          <span class="type-tag">{typeLabels[type]}</span>
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        </div>
        <h1>{title}</h1>
      </header>

      <div class="prose">
        <slot />
      </div>
    </article>
  </main>

  <footer class="footer">
    <p>{site.name} - {site.location}</p>
  </footer>
</Layout>
